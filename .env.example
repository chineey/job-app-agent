# ==============================================================================
# DEV A: INTAKE & TAILORING PIPELINE (REQUIRED FOR DEV A)
# ==============================================================================

# Database Connection (Neon Postgres)
DATABASE_URL="postgres://username:password@ep-sample-pool.us-east-1.aws.neon.tech/neondb?sslmode=require"
APP_BASE_URL="http://localhost:3000"

# Cron Worker Authentication (Protects /api/cron/ingest and /api/cron/process)
CRON_SECRET="dev-cron-secret-change-in-production"

# Google Gemini API (Multimodal Vision, Match, Tailor, Truth Verification Pass)
GEMINI_API_KEY="AIzaSyYourGeminiApiKey"
GEMINI_MODEL="gemini-1.5-flash"

# X (Twitter) API v2 (Ingestion & Thread Expansion)
X_BEARER_TOKEN="your-x-api-bearer-token"
X_MONTHLY_BUDGET_USD="20"
X_MAX_DAILY_READS="300"

# Vercel Blob Storage (Generated Resume PDF uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"


# ==============================================================================
# DEV B: PLATFORM, TELEGRAM & GMAIL DELIVERY (NOT REQUIRED FOR DEV A)
# ==============================================================================

# Telegram Bot & Admin Configuration
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
# TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"
# ADMIN_CHAT_ID="987654321"

# Google Cloud OAuth (Gmail Sending & Inbox Polling)
# GMAIL_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GMAIL_CLIENT_SECRET="your-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/gmail/callback"
# TOKEN_ENCRYPTION_KEY="your-32-byte-base64-encryption-key-here"

# System Quotas
# MAX_USERS="20"
